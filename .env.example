# ============================================================================
# BINANCE AGENTIC WALLET AUTOMATION ENGINE - ENVIRONMENT CONFIGURATION
# ============================================================================
# PENTING: Jangan pernah commit file .env asli ke Git!

# 1. Telegram Bot Configuration (WAJIB)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Pisahkan dengan koma jika lebih dari satu Telegram User ID (contoh: 123456789,987654321)
TELEGRAM_ALLOWED_USER_IDS=123456789

# 2. Binance Agentic Wallet CLI Configuration
BAW_BIN=baw
BAW_TIMEOUT_MS=45000
BAW_REQUIRED_CLI_VERSION=1.12.0
BAW_SKILL_VERSION=1.15.0
DEFAULT_CHAIN_ID=56
BSC_RPC_URL=https://bsc-rpc.publicnode.com

# 3. Security & Transaction Guardrails
# Set DRY_RUN=true untuk simulasi tanpa broadcast transaksi on-chain
DRY_RUN=false
KILL_SWITCH=false
# Batas maksimal pengeluaran per transaksi & harian dalam USD (layer proteksi tambahan di atas limit BAW)
MAX_TX_SPEND_USD=15
MAX_DAILY_SPEND_USD=50
# Masa berlaku konfirmasi transaksi di Telegram (detik)
TX_CONFIRMATION_TTL_SECONDS=300

# 4. AI Provider Configuration (Opsional - Direct Command tetap jalan tanpa AI)
# Primary: Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Secondary / Fallback: OpenAI-Compatible API (Groq / OpenRouter / DeepSeek / OpenAI)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile

# AI Budget & Rate Limits
AI_TIMEOUT_MS=20000
AI_MAX_CALLS_PER_HOUR=30
AI_MAX_TOKENS_PER_CALL=1024

# 5. Background Transaction Monitor
TX_MONITOR_INTERVAL_MS=15000
